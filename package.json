{
  "name": "@turtle-notes/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "turtleReleasePublisher": 2,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify": "npm run check && npm run build && node scripts/verify-build.mjs",
    "sync-release": "node scripts/sync-release.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
