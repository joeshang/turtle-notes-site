<button class="theme-toggle" type="button" aria-label="切换为夜间模式" title="切换为夜间模式">
  <svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z" /></svg>
  <svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2" /></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let manual = false;
  try { manual = ['light', 'dark'].includes(localStorage.getItem('turtle-theme') ?? ''); } catch { /* Storage can be unavailable. */ }
  function apply(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    const label = theme === 'dark' ? '切换为日间模式' : '切换为夜间模式';
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
    window.dispatchEvent(new CustomEvent('turtle:theme', { detail: theme }));
  }
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    manual = true;
    try { localStorage.setItem('turtle-theme', theme); } catch { /* The current page still works. */ }
    apply(theme);
  });
  system.addEventListener('change', event => { if (!manual) apply(event.matches ? 'dark' : 'light'); });
  apply(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
</script>
