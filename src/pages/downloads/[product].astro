---
import { withBase } from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { products, brand, notesIOS, iosDownloadLinks } from '../../data/site';
import type { Product } from '../../data/site';
export function getStaticPaths() {
  return products.map(product => ({ params: { product: product.id }, props: { product } }));
}
interface Props { product: Product; }
const { product } = Astro.props;
const { release } = product;
---
<Layout title={`${product.chineseName}下载`} description={`${product.slogan}。${product.chineseName}的${product.id === 'notes' ? ' macOS 与 iOS ' : ' macOS '}下载入口、系统要求与发行状态。`}>
  <header class="document-hero container"><p class="eyebrow">{product.name} / DOWNLOAD</p><div class="download-page-title"><img src={withBase(product.icon)} width="64" height="64" alt="" /><h1>{product.chineseName}下载</h1></div><p>{product.slogan}。{product.description}</p></header>
  <article class="document-content container">
    <section class="download-platform" id="macos" aria-label="macOS 版下载"><h2 class="platform-heading">macOS 版</h2>
    {release ? <div class="contact-panel"><p class="eyebrow">正式发行版本</p><h2>v{release.version}</h2><p>macOS {release.minimumMacOS} 或更新版本 · {release.architecture}</p><a class="button button-primary download-action" href={release.downloadURL}><Icon name="down" size={19} />下载 {product.chineseName}</a><p><a href={release.checksumURL}>下载 SHA-256 校验文件</a></p><h3>安装方法</h3><p>打开下载的 DMG，将{product.chineseName}拖入 Applications（应用程序）文件夹，再从应用程序中打开。升级时退出正在运行的 App，用新版替换原应用。</p></div> : <div class="contact-panel"><p class="eyebrow">公开下载准备中</p><h2>正式安装包尚未开放</h2><p>本页是{product.chineseName}的独立下载入口。安装包、发行版本、处理器架构和校验文件将在正式发行并验证后提供。</p><p>当前代码要求 macOS {product.minimumMacOS} 或更新版本。</p></div>}
    </section>
    {product.id === 'notes' && <section class="download-platform ios-download" id="ios" aria-labelledby="ios-title"><div class="ios-download-heading"><span class="platform-kicker">iPhone / iPad</span><h2 id="ios-title">龙龟笔记 iOS 版</h2></div><p>在 iPhone 与 iPad 上随身记录，使用原生 Markdown 正文渲染与编辑。</p><p>需要 iOS {notesIOS.minimumIOS} 或更新版本。</p>{iosDownloadLinks.length > 0 ? <div class="ios-download-actions">{iosDownloadLinks.map(link => <a class="button button-primary" href={link.url}><Icon name="arrow" size={18} />{link.label}</a>)}</div> : <div class="ios-availability"><span class="status-dot"></span><div><strong>公开下载准备中</strong><p>App Store 或 TestFlight 开放后，将在这里提供正式跳转入口。</p></div></div>}</section>}
    <h2>你可能也需要</h2>{products.filter(item => item.id !== product.id).map(item => <p><a href={withBase(`/downloads/${item.id}/`)}>{item.chineseName}下载 →</a><br />{item.description}</p>)}
    <h2>下载与使用问题</h2><p>请联系 <a href={`mailto:${brand.supportEmail}`}>{brand.supportEmail}</a>，或前往<a href={withBase('/support/')}>支持页面</a>。数据处理方式请参阅<a href={withBase('/privacy/')}>隐私政策</a>。</p>
  </article>
</Layout>
