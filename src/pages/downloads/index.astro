---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { products, notesIOS, iosDownloadLinks, webClipper } from '../../data/site';
import { withBase } from '../../lib/paths';
---
<Layout title="下载" description="下载龙龟笔记与龙龟编辑器，查看版本信息和系统要求。">
  <header class="download-header container">
    <h1>下载</h1>
  </header>
  <div class="download-content container">
    {products.map(product => <section class="download-card" id={product.id} aria-labelledby={`${product.id}-title`}>
      <div class="download-card-header">
        <h2 id={`${product.id}-title`}>{product.chineseName}</h2>
        <span class="download-status">{product.release ? `v${product.release.version}` : '准备中'}</span>
      </div>
      <p class="download-requirements">macOS {product.release?.minimumMacOS ?? product.minimumMacOS} 或更新版本{product.release && ` · ${product.release.architecture}`}</p>
      {product.release && <div class="download-actions">
        <a class="button button-primary" href={product.release.downloadURL} aria-label={`下载${product.chineseName} macOS 版`}><Icon name="down" size={18} />下载 macOS 版</a>
        <a class="download-checksum" href={product.release.checksumURL} aria-label={`${product.chineseName} SHA-256 校验文件`}>SHA-256 校验文件</a>
        <a class="download-checksum" href={withBase('/changelog/')} aria-label={`${product.chineseName}更新日志`}>更新日志（CHANGELOG）</a>
      </div>}
      {product.id === 'notes' && <div class="download-ios" id="ios">
        <div class="download-card-header">
          <h3>iOS 版</h3>
          {iosDownloadLinks.length === 0 && <span class="download-status">准备中</span>}
        </div>
        <p class="download-requirements">iOS {notesIOS.minimumIOS} 或更新版本 · iPhone / iPad</p>
        {iosDownloadLinks.length > 0 && <div class="download-actions">
          {iosDownloadLinks.map(link => <a class="button button-primary" href={link.url}>{link.label}<Icon name="arrow" size={18} /></a>)}
        </div>}
      </div>}
    </section>)}
    <section class="download-card" id="web-clipper" aria-labelledby="web-clipper-title">
      <div class="download-card-header"><h2 id="web-clipper-title">龙龟剪藏</h2><span class="download-status">Chrome 扩展</span></div>
      <p class="download-requirements">剪藏网页正文或选中片段，保存到龙龟笔记。也可复制 Markdown 或导出 .md 文件。</p>
      <div class="download-actions"><a class="button button-primary" href={webClipper.storeURL} target="_blank" rel="noopener noreferrer">添加到 Chrome <Icon name="arrow" size={18} /></a><a class="download-checksum" href={withBase('/web-clipper/#setup')}>安装与使用说明</a></div>
      <p class="download-note clipper-download-note">保存到笔记需要 macOS 14 或更新版本及龙龟笔记 {webClipper.minimumNotesVersion} 或更新版本；当前 macOS 安装包适用于 Apple Silicon。</p>
    </section>
    <p class="download-note download-install">macOS 安装：打开 DMG，将应用拖入“应用程序”文件夹。升级前请先退出正在运行的应用。</p>
  </div>
</Layout>
