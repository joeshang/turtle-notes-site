---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import AppPreview from '../components/AppPreview.astro';
import { products } from '../data/site';
---
<Layout title="龙龟，自在书写">
  <section class="hero container">
    <div class="hero-lead">
      <div class="hero-copy">
        <h1>
          <span class="hero-slogan">龙龟<span class="title-period">，</span></span>
          <span class="hero-slogan"><span class="hero-emphasis">自在书写<span class="hand-line" aria-hidden="true"></span></span><span class="title-period">。</span></span>
        </h1>
        <div class="hero-actions"><a class="button button-primary" href="#notes">探索龙龟笔记 <Icon name="arrow" size={16} /></a><a class="button button-outline" href="#editor">探索龙龟编辑器 <Icon name="arrow" size={16} /></a></div>
        <p class="hero-meta">Apple 平台原生 Markdown 渲染，轻快跟手，让写作流畅自然。</p>
      </div>
      <div class="hero-art" aria-hidden="true"><span class="hero-turtle"></span></div>
    </div>
    <div class="product-choice" id="download" aria-label="选择产品并下载">
      {products.map(item => <article>
        <img src={withBase(item.icon)} width="52" height="52" alt="" />
        <div class="product-card-copy"><h2>{item.chineseName}</h2><p>{item.description}</p></div>
        <div class="product-platforms">
          <a href={withBase(`/downloads/#${item.id}`)} aria-label={`前往${item.chineseName} macOS 下载页`} class="platform-link">macOS <Icon name="arrow" size={13} /></a>
          {item.id === 'notes' && <a href={withBase('/downloads/#ios')} aria-label="龙龟笔记 iOS 下载" class="platform-link">iOS <Icon name="arrow" size={13} /></a>}
        </div>
      </article>)}
    </div>
  </section>
  <section class="product-section container" id="notes">
    <div class="product-heading">
      <h2>龙龟载思，<span>灵感相连。</span></h2>
      <p class="product-description">龙龟笔记 · {products.find(product => product.id === 'notes')?.description}</p>
    </div>
    <AppPreview product="notes" />
    <div class="product-benefits notes-benefits"><article><Icon name="write" size={21} /><h3>随手记下，留住灵感</h3><p>从一句话到一篇长文，在本地笔记库里持续积累。</p></article><article><Icon name="tag" size={21} /><h3>层级标签，梳理思绪</h3><p>按主题组织内容，用关键词与待办搜索找回笔记。</p></article><article><Icon name="link" size={21} /><h3>双向链接，连接想法</h3><p>在笔记之间建立联系，沿着一个念头发现另一条思路。</p></article><article><Icon name="cloud" size={21} /><h3>iCloud 同步，多端接续</h3><p>开启 iCloud 同步，在 Mac、iPhone 与 iPad 之间接续记录与编辑。</p></article></div>
  </section>
  <section class="product-section editor-section container" id="editor">
    <div class="product-heading">
      <h2>龙龟载文，<span>落笔成章。</span></h2>
      <p class="product-description">龙龟编辑器 · {products.find(product => product.id === 'editor')?.description}</p>
    </div>
    <AppPreview product="editor" />
    <div class="product-benefits"><article><Icon name="file" size={21} /><h3>打开即写，保存即得</h3><p>直接编辑独立 Markdown 文件，支持保存、另存为与多文稿标签页。</p></article><article><Icon name="write" size={21} /><h3>从思路，到清晰的表达</h3><p>标题大纲帮助梳理结构，表格、公式与 Mermaid 承载更丰富的内容。</p></article><article><Icon name="down" size={21} /><h3>写成文章，自由带走</h3><p>保存 Markdown 源文件，或导出 PDF，把完成的文稿交给下一位读者。</p></article></div>
  </section>
  <section class="compare-section"><div class="container compare-inner"><div><p class="eyebrow">同源的编辑体验，各自的内容归属</p><h2>笔记载思，<br />文稿成章。</h2><p>你决定如何开始。<br />龙龟，为文字找到合适的容器。</p></div><div class="comparison"><table><caption class="sr-only">龙龟笔记与龙龟编辑器对比</caption><thead><tr><th scope="col">你的写作方式</th><th scope="col">龙龟笔记</th><th scope="col">龙龟编辑器</th></tr></thead><tbody><tr><th scope="row">内容归属</th><td>笔记库</td><td>独立 Markdown 文件</td></tr><tr><th scope="row">适合用来</th><td>积累、整理、连接</td><td>打开、写作、保存</td></tr><tr><th scope="row">Markdown / PDF 导出</th><td>支持</td><td>支持</td></tr><tr><th scope="row">离线编辑</th><td>支持</td><td>支持</td></tr><tr><th scope="row">内置 iCloud 同步</th><td>可用版本中按需开启</td><td>无内置同步</td></tr></tbody></table></div></div></section>
  <section class="faq-section container section-space" id="faq"><div class="faq-intro"><p class="eyebrow">GOOD TO KNOW</p><h2>落笔之前，<br />你可能还想知道。</h2><p>关于两款 App、内容归属与开始使用。</p></div><FAQ /></section>
</Layout>
