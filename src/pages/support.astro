---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { brand } from '../data/site';
---
<Layout title="联系与支持" description="联系龙龟笔记与龙龟编辑器开发者，反馈使用问题或提出功能建议。">
  <header class="document-hero container">
    <h1>联系与支持</h1>
    <p>有使用问题或功能建议，欢迎给我写信。</p>
  </header>
  <article class="document-content container">
    <div class="contact-panel">
      <p class="eyebrow">联系开发者</p>
      <a href={`mailto:${brand.supportEmail}?subject=${encodeURIComponent('龙龟使用反馈')}`}><Icon name="mail" size={23} />{brand.supportEmail}</a>
    </div>
    <h2>反馈问题时，请附上</h2>
    <ul>
      <li>应用名称与版本，以及 macOS / iOS 版本。</li>
      <li>问题描述和复现步骤。</li>
      <li>相关截图或示例文稿（如有，请去除私人信息）。</li>
    </ul>
  </article>
</Layout>
