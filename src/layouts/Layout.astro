---
import { withBase } from '../lib/paths';
import '../styles/global.css';
import { brand } from '../data/site';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = '龙龟载文，落笔成章', description = brand.description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const image = Astro.site ? new URL(withBase('/images/notes-app.png'), Astro.site) : undefined;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('turtle-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Turtle 龙龟</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f5" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Turtle 龙龟 · 笔记与编辑器" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/images/app-icon.png')} />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={withBase('/')} class="brand" aria-label="Turtle 龙龟首页">
          <img src={withBase('/images/app-icon.png')} width="38" height="38" alt="" />
          <span>Turtle<small>龙龟 · 笔记与编辑器</small></span>
        </a>
        <nav aria-label="主导航">
          <a href={withBase('/#notes')}>龙龟笔记</a><a href={withBase('/#editor')}>龙龟编辑器</a>
          <a href={withBase('/support/')} aria-current={path === withBase('/support/') ? 'page' : undefined}>支持</a>
        </nav>
        <ThemeToggle />
        <a class="nav-cta" href={withBase('/#download')}>下载 macOS 版 <Icon name="arrow" size={15} /></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a href={withBase('/')} class="brand"><img src={withBase('/images/app-icon.png')} width="36" height="36" alt="" /><span>Turtle <span class="brand-light">龙龟</span></span></a>
        <p>龙龟载文，落笔成章。</p>
        <nav aria-label="页脚导航"><a href={withBase('/downloads/notes/')}>笔记下载</a><a href={withBase('/downloads/editor/')}>编辑器下载</a><a href={withBase('/support/')}>联系与支持</a><a href={withBase('/privacy/')}>隐私政策</a></nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Turtle 龙龟</span><span>为每一个值得留下的想法。</span></div>
    </footer>
  </body>
</html>
